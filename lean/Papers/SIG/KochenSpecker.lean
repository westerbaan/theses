/-- The integer dot product on `ℤ³`. -/
def dotZ (r s : Fin 3 → ℤ) : ℤ := r 0 * s 0 + r 1 * s 1 + r 2 * s 2

theorem nb {x y : Bool} (h : x = true → y = true → False) (hx : x = true) : y = false := by
  cases y
  · rfl
  · exact (h hx rfl).elim

theorem nb' {x y : Bool} (h : x = true → y = true → False) (hy : y = true) : x = false := by
  cases x
  · rfl
  · exact (h rfl hy).elim

theorem tr1 {x y z : Bool} (h : x = true ∨ y = true ∨ z = true) (hy : y = false) (hz : z = false) :
    x = true := by
  subst hy hz; simpa using h

theorem tr2 {x y z : Bool} (h : x = true ∨ y = true ∨ z = true) (hx : x = false) (hz : z = false) :
    y = true := by
  subst hx hz; simpa using h

theorem tr3 {x y z : Bool} (h : x = true ∨ y = true ∨ z = true) (hx : x = false) (hy : y = false) :
    z = true := by
  subst hx hy; simpa using h

theorem tr0 {x y z : Bool} (h : x = true ∨ y = true ∨ z = true) (hx : x = false) (hy : y = false)
    (hz : z = false) : False := by
  subst hx hy hz; simp at h

